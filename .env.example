# App mode: sandbox (default, no backend) | live (real APIs)
VITE_APP_MODE=sandbox

# Core Pave360 CPaaS API
VITE_PAVE360_BASE_URL=https://api.pave360.com

# Pave360 VAS Backend API
# Leave empty in sandbox. Set when your backend is deployed.
VITE_VAS_API_URL=

# Hubtel minimum load amount (GH₵)
VITE_HUBTEL_MIN_AMOUNT=10
